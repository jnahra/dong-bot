# Copy to .env and fill in. Nothing is posted while DRY_RUN=true.
DRY_RUN=true

# X API (OAuth 1.0a user context) for the bot account; app needs Read and write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# What to post
NEAR_WALL_FT=20
BATTERS=all
MAX_POSTS_PER_GAME=12
HASHTAG=#GuardsBall
HANDLE=

# R regular season, F/D/L/W postseason, S spring training
GAME_TYPES=R,F,D,L,W
